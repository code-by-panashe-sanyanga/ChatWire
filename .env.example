# copy to .env for local overrides
SECRET_KEY=change-me-in-production
# * is fine for local / same-origin deploys. Pin hosts if the UI is on another domain.
CORS_ORIGINS=*
PORT=5001
# Keep 0 for anything public. Local only: FLASK_DEBUG=1
FLASK_DEBUG=0
# Set on Railway / production so a weak SECRET_KEY refuses to boot
# CHATWIRE_ENV=production
# Durable SQLite + uploads (Railway volume mount path)
# DATA_DIR=/data
# Optional override for the DB file itself
# CHATWIRE_DB_PATH=/data/chatwire.db
# Optional TURN for Meet now / Go live across NATs (comma-separated URLs)
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
